# ==========================================
# fcus - Focus & Relaxation Timer Configuration
# ==========================================

# ------------------------------------------
# 1. Gemini AI API Key (Server-Side)
# ------------------------------------------
# Optional / Recommended: Powers AI Practice Questions and Work Activity Evaluation
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ------------------------------------------
# 2. Firebase Web Configuration (Client-Side)
# ------------------------------------------
# Optional: Required for Cloud Authentication (Google/Email) & Cross-Device Stats Sync.
# Create a free project at: https://console.firebase.google.com/
# Enable: Authentication (Google + Email) & Cloud Firestore
# Copy config from: Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Optional custom Firestore database ID (leave blank or '(default)' for standard default database)
VITE_FIREBASE_DATABASE_ID=""

# ------------------------------------------
# 3. Application Hosting
# ------------------------------------------
APP_URL=""

